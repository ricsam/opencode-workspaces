diff --git a/packages/app/src/context/platform-workspaces.tsx b/packages/app/src/context/platform-workspaces.tsx
new file mode 100644
index 0000000..73938de
--- /dev/null
+++ b/packages/app/src/context/platform-workspaces.tsx
@@ -0,0 +1,60 @@
+import { createContext, createResource, type ParentProps, Show, useContext } from "solid-js"
+
+export type PlatformWorkspaces = {
+  user: {
+    id: string
+    username: string
+    displayName: string
+    role: "admin" | "user"
+    isAdmin: boolean
+  }
+  branding: {
+    name: string
+    logoUrl?: string
+    faviconUrl?: string
+    accent?: string
+  }
+  adminUrl: string
+}
+
+const Context = createContext<PlatformWorkspaces | undefined>()
+
+export function PlatformWorkspacesProvider(props: ParentProps) {
+  const [platform] = createResource(async () => {
+    if (typeof window === "undefined") return
+    const response = await fetch("/platform/api/v1/bootstrap", { credentials: "same-origin" }).catch(() => undefined)
+    if (!response?.ok) return
+    const value = (await response.json()) as PlatformWorkspaces
+    if (value.branding.name) document.title = value.branding.name
+    if (value.branding.accent) document.documentElement.style.setProperty("--ocw-accent", value.branding.accent)
+    if (value.branding.faviconUrl) {
+      const favicon = document.querySelector<HTMLLinkElement>("link[rel~='icon']") ?? document.createElement("link")
+      favicon.rel = "icon"
+      favicon.href = value.branding.faviconUrl
+      if (!favicon.parentNode) document.head.appendChild(favicon)
+    }
+    return value
+  })
+
+  const value = () => platform()
+  return <Context.Provider value={value()}>{props.children}</Context.Provider>
+}
+
+export function usePlatformWorkspaces() {
+  return useContext(Context)
+}
+
+export function PlatformAdminLink() {
+  const platform = usePlatformWorkspaces()
+  return (
+    <Show when={platform?.user.isAdmin}>
+      <a
+        href={platform?.adminUrl ?? "/platform/admin"}
+        class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium text-text-weak hover:text-text-strong hover:bg-surface-raised-base-hover"
+        title="OpenCode Workspaces administration"
+      >
+        Admin
+      </a>
+    </Show>
+  )
+}
