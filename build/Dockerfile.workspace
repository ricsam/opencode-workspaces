# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.14-debian AS build
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential python3 node-gyp git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY upstream/opencode/package.json upstream/opencode/bun.lock upstream/opencode/bunfig.toml ./
COPY upstream/opencode/packages ./packages
COPY upstream/opencode/patches ./patches
COPY upstream/patches ./workspaces-patches
RUN git apply workspaces-patches/*.patch
COPY upstream/opencode/script ./script
COPY upstream/opencode/tsconfig.json upstream/opencode/turbo.json ./
COPY upstream/opencode/.github/TEAM_MEMBERS ./.github/TEAM_MEMBERS
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
ARG TARGETARCH
ENV OPENCODE_CHANNEL=workspaces OPENCODE_VERSION=1.18.14
RUN if [ "$TARGETARCH" = "amd64" ]; then bun run --cwd packages/opencode build --single --baseline --skip-install; \
    else bun run --cwd packages/opencode build --single --skip-install; fi
RUN if [ "$TARGETARCH" = "arm64" ]; then cp packages/opencode/dist/opencode-linux-arm64/bin/opencode /tmp/opencode-bin; \
    else cp packages/opencode/dist/opencode-linux-x64-baseline/bin/opencode /tmp/opencode-bin; fi

FROM debian:bookworm-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    bash ca-certificates curl git git-lfs jq less openssh-client python3 python3-pip ripgrep sudo tini unzip vim wget xz-utils \
    build-essential && rm -rf /var/lib/apt/lists/*
COPY --from=build --chmod=0755 /tmp/opencode-bin /usr/local/bin/opencode
RUN /usr/local/bin/opencode --version
COPY build/workspace-entrypoint.sh /usr/local/bin/workspace-entrypoint
ENV HOME=/workspace/home XDG_DATA_HOME=/workspace/home/.local/share XDG_CONFIG_HOME=/workspace/home/.config WORKSPACE_DIR=/workspace/projects
# The PVC mount does not exist in the immutable image. Start from an existing
# directory; the entrypoint creates and changes to WORKSPACE_DIR after mount.
WORKDIR /
EXPOSE 4096
ENTRYPOINT ["/usr/bin/tini","--","/usr/local/bin/workspace-entrypoint"]
