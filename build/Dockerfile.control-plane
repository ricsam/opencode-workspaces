# syntax=docker/dockerfile:1.7
FROM golang:1.24.7-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/opencode-workspaces ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/opencode-workspaces /usr/local/bin/opencode-workspaces
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/opencode-workspaces"]
